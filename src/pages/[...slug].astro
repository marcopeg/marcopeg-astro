---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';
import { filterDrafts, getSlugFromId } from '../utils/posts';

export async function getStaticPaths() {
	const posts = filterDrafts(await getCollection('posts'));
	const pages = await getCollection('pages');

	return [
		...posts.map((post) => ({
			params: { slug: getSlugFromId(post.id) },
			props: { entry: post, type: 'post' },
		})),
		...pages.map((page) => ({
			// Use slug from frontmatter, or fall back to filename (page.id)
			params: { slug: page.data.slug || page.id },
			props: { entry: page, type: 'page' },
		})),
	];
}

type Props = {
	entry: CollectionEntry<'posts'> | CollectionEntry<'pages'>;
	type: 'post' | 'page';
};

const { entry, type } = Astro.props;
const { Content } = await render(entry);

// Helper function to format filename as title
function formatTitle(slug: string): string {
	return slug
		.split('-')
		.map(word => word.charAt(0).toUpperCase() + word.slice(1))
		.join(' ');
}

// For pages without frontmatter, derive defaults from filename
const pageData = type === 'page' ? {
	title: entry.data.title || formatTitle(entry.data.slug || entry.id),
	description: entry.data.description || '',
	pubDate: entry.data.pubDate,
	heroImage: entry.data.heroImage,
	slug: entry.data.slug || entry.id,
	body: entry.body,
} : { ...entry.data, body: entry.body };
---

<BlogPost {...pageData}>
	<Content />

	{pageData.slug === 'about' && (
		<>
			<div class="tags-list">
				{(await getCollection('tags')).map((tag) => (
					<a href={`/tag/${tag.id}`} class="tag-item">
						<img src={tag.data.image} alt={tag.data.title} class="tag-image" />
						<div class="tag-content">
							<h3 class="tag-title">{tag.data.title}</h3>
							<p class="tag-description">{tag.data.excerpt}</p>
						</div>
					</a>
				))}
			</div>

			<style>
				.tags-list {
					display: flex;
					flex-direction: column;
					gap: 0;
					margin-top: 4rem;
					border-top: 1px solid #e5e7eb;
				}

				.tag-item {
					display: flex;
					gap: 2.4rem;
					align-items: center;
					text-decoration: none !important;
					color: inherit;
					padding: 2.4rem 0;
					border-bottom: 1px solid #e5e7eb;
					transition: opacity 0.2s ease;
				}

				.tag-item * {
					text-decoration: none !important;
				}

				.tag-item:hover {
					opacity: 0.7;
				}

				.tag-item:hover .tag-title {
					color: var(--accent);
				}

				.tag-image {
					width: 120px;
					height: 80px;
					object-fit: cover;
					border-radius: 4px;
					flex-shrink: 0;
				}

				.tag-content {
					flex: 1;
					min-width: 0;
				}

				.tag-title {
					margin: 0 0 0.6rem 0;
					font-size: 1.8rem;
					font-weight: 700;
					color: #15171a;
					letter-spacing: -0.01em;
					transition: color 0.2s ease;
					text-decoration: none;
				}

				.tag-description {
					margin: 0;
					font-size: 1.5rem;
					line-height: 1.5;
					color: #738a94;
					font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
					text-decoration: none;
				}

				@media (max-width: 640px) {
					.tag-item {
						gap: 1.6rem;
						padding: 2rem 0;
					}

					.tag-image {
						width: 100px;
						height: 67px;
					}

					.tag-title {
						font-size: 1.6rem;
					}

					.tag-description {
						font-size: 1.4rem;
					}
				}
			</style>
		</>
	)}
</BlogPost>
