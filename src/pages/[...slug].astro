---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';
import { filterDrafts } from '../utils/posts';

export async function getStaticPaths() {
	const posts = filterDrafts(await getCollection('posts'));
	const pages = await getCollection('pages');

	return [
		...posts.map((post) => ({
			params: { slug: post.id },
			props: { entry: post, type: 'post' },
		})),
		...pages.map((page) => ({
			// Use slug from frontmatter, or fall back to filename (page.id)
			params: { slug: page.data.slug || page.id },
			props: { entry: page, type: 'page' },
		})),
	];
}

type Props = {
	entry: CollectionEntry<'posts'> | CollectionEntry<'pages'>;
	type: 'post' | 'page';
};

const { entry, type } = Astro.props;
const { Content } = await render(entry);

// Helper function to format filename as title
function formatTitle(slug: string): string {
	return slug
		.split('-')
		.map(word => word.charAt(0).toUpperCase() + word.slice(1))
		.join(' ');
}

// For pages without frontmatter, derive defaults from filename
const pageData = type === 'page' ? {
	title: entry.data.title || formatTitle(entry.data.slug || entry.id),
	description: entry.data.description || '',
	pubDate: entry.data.pubDate,
	heroImage: entry.data.heroImage,
	slug: entry.data.slug || entry.id,
} : entry.data;
---

<BlogPost {...pageData}>
	<Content />

	{pageData.slug === 'about' && (
		<>
			<hr />
			<h2>Browse by Topic</h2>
			<div class="tags-list">
				{(await getCollection('tags')).map((tag) => (
					<a href={`/tag/${tag.id}`} class="tag-item">
						<img src={tag.data.image} alt={tag.data.title} class="tag-image" />
						<div class="tag-content">
							<h3 class="tag-title">{tag.data.title}</h3>
							<p class="tag-description">{tag.data.excerpt}</p>
						</div>
					</a>
				))}
			</div>

			<style>
				.tags-list {
					display: flex;
					flex-direction: column;
					gap: 2rem;
					margin-top: 2rem;
				}

				.tag-item {
					display: flex;
					gap: 2rem;
					text-decoration: none;
					color: inherit;
					padding: 1.5rem;
					border-radius: 8px;
					transition: background-color 0.2s ease;
				}

				.tag-item:hover {
					background-color: rgb(var(--gray-light));
				}

				.tag-image {
					width: 200px;
					height: 150px;
					object-fit: cover;
					border-radius: 5px;
					flex-shrink: 0;
				}

				.tag-content {
					flex: 1;
					display: flex;
					flex-direction: column;
					justify-content: center;
				}

				.tag-title {
					margin: 0 0 0.5rem 0;
					font-size: 2rem;
					font-weight: 700;
					color: rgb(var(--black));
				}

				.tag-description {
					margin: 0;
					font-size: 1.5rem;
					line-height: 1.5;
					color: rgb(var(--gray-dark));
				}

				@media (max-width: 767px) {
					.tag-item {
						flex-direction: column;
						gap: 1rem;
					}

					.tag-image {
						width: 100%;
						height: 200px;
					}
				}
			</style>
		</>
	)}
</BlogPost>
