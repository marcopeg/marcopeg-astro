---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { filterDrafts } from '../utils/posts';

type Props = {
	title: string;
	description?: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: string;
	tags?: string[];
	slug?: string;
};

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
const firstTag = tags?.[0];

// Get related articles based on shared tags
let relatedPosts: CollectionEntry<'posts'>[] = [];
if (tags && tags.length > 0) {
	const allPosts = filterDrafts(await getCollection('posts'));

	relatedPosts = allPosts
		.filter(post => {
			// Exclude current post (compare by title or slug)
			if (post.data.title === title) return false;

			// Check if post has at least one shared tag
			return post.data.tags?.some(tag => tags.includes(tag));
		})
		.sort((a, b) => {
			// Sort by number of shared tags (most relevant first)
			const sharedA = a.data.tags?.filter(tag => tags.includes(tag)).length || 0;
			const sharedB = b.data.tags?.filter(tag => tags.includes(tag)).length || 0;
			return sharedB - sharedA;
		})
		.slice(0, 6); // Limit to 6 related posts
}
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			/* Reset any global constraints that might interfere with the grid */
			main {
				padding: 4rem 0;
				width: 100% !important;
				max-width: none !important;
				margin: 0 !important;
				column-count: 1 !important;
				display: block !important;
			}

			.gh-article {
				display: block !important;
				column-count: 1 !important;
				width: 100%;
			}

			/* gh-canvas Grid System */
			.gh-canvas {
				display: grid;
				grid-template-columns:
					[full-start] minmax(20px, 1fr)
					[wide-start] minmax(0, 240px)
					[main-start] min(720px, calc(100% - 40px)) [main-end]
					minmax(0, 240px) [wide-end]
					minmax(20px, 1fr) [full-end];
				width: 100%;
			}

			/* All direct children of a gh-canvas grid default to the main column */
			.gh-canvas > * {
				grid-column: main-start / main-end;
			}

			/* Breakout columns */
			.gh-canvas > .kg-width-wide {
				grid-column: wide-start / wide-end;
			}

			.gh-canvas > .kg-width-full {
				grid-column: full-start / full-end;
				width: 100%;
			}

			.article-header {
				padding-bottom: 4rem;
				text-align: left;
				grid-column: main-start / main-end;
			}

			.article-tag {
				display: block;
				margin-bottom: 0.5rem;
				color: #979797;
				font-size: 1.6rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}

			.article-title {
				margin: 0 0 1.5rem 0;
				color: #15171a;
				font-size: 5.2rem;
				font-weight: 800;
				line-height: 1.05;
			}

			.article-excerpt {
				margin: 0 0 2rem 0;
				color: #15171a;
				font-size: 2rem;
				line-height: 1.45;
			}

			.article-image {
				margin: 2rem 0 4rem 0;
				grid-column: wide-start / wide-end;
			}

			.article-image img {
				display: block;
				width: 100%;
				height: auto;
				max-width: none;
				border-radius: 4px;
			}

			/* Content Layout & Typography */
			.gh-content {
				display: grid;
				grid-template-columns:
					[full-start] minmax(20px, 1fr)
					[wide-start] minmax(0, 240px)
					[main-start] min(720px, calc(100% - 40px)) [main-end]
					minmax(0, 240px) [wide-end]
					minmax(20px, 1fr) [full-end];
				column-count: 1 !important;
				font-family: Georgia, Times, serif !important;
			}

			/* Explicitly place all direct children (including Slot content) in the main column */
			.gh-content > :global(*) {
				grid-column: main-start / main-end;
			}

			/* Allow breakout classes within content as well */
			.gh-content > :global(.kg-width-wide) {
				grid-column: wide-start / wide-end;
			}

			.gh-content > :global(.kg-width-full) {
				grid-column: full-start / full-end;
			}

			.gh-content :global(p),
			.gh-content :global(li),
			.gh-content :global(blockquote) {
				margin: 0 0 1.5em 0;
				font-family: Georgia, Times, serif !important;
				font-size: 2rem;
				line-height: 1.6;
				color: #15171a;
				column-count: 1 !important;
			}

			.gh-content :global(h2) {
				font-size: 3.2rem;
				margin: 1.5em 0 0.5em 0;
			}

			.gh-content :global(blockquote) {
				margin: 2rem 0;
				padding: 0 0 0 2rem;
				border-left: 3px solid var(--accent);
				font-style: italic;
				font-size: 2.4rem;
			}

			.gh-content :global(hr) {
				margin: 4rem 0;
			}

			/* Related Articles Section */
			.related-articles {
				margin-top: 8rem;
				padding-top: 4rem;
				border-top: 1px solid #e5eff5;
				grid-column: main-start / main-end;
			}

			.related-articles h2 {
				font-size: 3.2rem;
				font-weight: 800;
				margin: 0 0 3rem 0;
				color: #15171a;
			}

			.related-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 3rem;
			}

			.related-post {
				display: flex;
				flex-direction: column;
				text-decoration: none;
				color: inherit;
			}

			.related-post:hover .related-title {
				color: var(--accent);
			}

			.related-image {
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: 5px;
				margin-bottom: 1.5rem;
			}

			.related-tag {
				display: block;
				font-size: 1.2rem;
				font-weight: 600;
				text-transform: uppercase;
				color: #738a94;
				margin-bottom: 0.5rem;
			}

			.related-title {
				font-size: 2rem;
				font-weight: 700;
				line-height: 1.3;
				color: #15171a;
				margin: 0 0 0.5rem 0;
				transition: color 0.2s ease;
			}

			.related-excerpt {
				font-size: 1.5rem;
				line-height: 1.5;
				color: #738a94;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			@media (max-width: 767px) {
				.article-title {
					font-size: 3.2rem;
				}
				.article-excerpt {
					font-size: 1.7rem;
				}
				.gh-content :global(p),
				.gh-content :global(li) {
					font-size: 1.8rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="gh-article">
				<header class="gh-canvas">
					<div class="article-header">
						{firstTag && <span class="article-tag">{firstTag}</span>}
						<h1 class="article-title">{title}</h1>
						<p class="article-excerpt">{description}</p>
					</div>

					{heroImage && (
						<figure class="article-image kg-width-wide">
							<Image width={1200} height={800} src={heroImage} alt={title} />
						</figure>
					)}
				</header>

				<section class="gh-content gh-canvas">
					<slot />

					{relatedPosts.length > 0 && (
						<div class="related-articles">
							<h2>Related Articles</h2>
							<div class="related-grid">
								{relatedPosts.map((post) => (
									<a href={`/${post.id}/`} class="related-post">
										{post.data.heroImage && (
											<img
												src={post.data.heroImage}
												alt={post.data.title}
												class="related-image"
											/>
										)}
										<span class="related-tag">
											{post.data.tags?.[0] || '\u00A0'}
										</span>
										<h3 class="related-title">{post.data.title}</h3>
										<p class="related-excerpt">{post.data.description}</p>
									</a>
								))}
							</div>
						</div>
					)}
				</section>
			</article>
		</main>
		<Footer />
	</body>
</html>
